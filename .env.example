# Copie este arquivo para .env e preencha com o SEU projeto Supabase.
# As variáveis com prefixo VITE_ vão para o navegador — use só a chave anon/publishable.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave pública VAPID (gere o par com: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Apenas no servidor (Supabase Edge Functions / secrets). NÃO use prefixo VITE_.
# Configure com `npx supabase secrets set ...` ou na tabela config_privada.
# ---------------------------------------------------------------------------
# CRON_SECRET=um-segredo-longo
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@email.com
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Planner <planner@seudominio.com>
# APP_URL=https://seu-app.vercel.app
